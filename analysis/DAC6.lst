                      (     gameplay.asm):00001         ; Native 6809 controls and scrolling of the original stage tilemaps.
                      (     gameplay.asm):00002         ; RAM: 192-line ring + 192-line mirror, physical banks 0..5 (48 KiB).
                      (     gameplay.asm):00003         ; Bank 6 holds permanent auxiliary code/data; bank 7 holds PCM effects.
                      (     gameplay.asm):00004         ; CPU $8000 is a framebuffer window; $a000 tiles; $c000 sprites/HUD.
     0D00             (     gameplay.asm):00005         TILE_ROW        equ $0d00
     0E00             (     gameplay.asm):00006         SAVED_PLAYER    equ $0e00
     1000             (     gameplay.asm):00007         SCANLINE        equ $1000
     00B0             (     gameplay.asm):00008         VIEW_HEIGHT     equ 176
     07A0             (     gameplay.asm):00009         MAP_HEIGHT      equ 1952
