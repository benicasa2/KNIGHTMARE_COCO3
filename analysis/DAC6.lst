                      (campaign_maps.asm):00001         ; Original 4x4 dictionary/repetition/mirror decoder, one 128-byte band.
                      (campaign_maps.asm):00002         ; The active map is cached in CPU $0400..$047f, not expanded over bank 7.
     0400             (campaign_maps.asm):00003         MAP_CACHE equ $0400
     0D20             (campaign_maps.asm):00004         MAP_LIST equ $0d20
