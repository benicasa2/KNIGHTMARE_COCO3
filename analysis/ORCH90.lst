                      (ardware_probe.asm):00169                 include "campaign_maps.asm"
                      (campaign_maps.asm):00001         ; Original 4x4 dictionary/repetition/mirror decoder, one 128-byte band.
                      (campaign_maps.asm):00002         ; The active map is cached in CPU $0400..$047f, not expanded over bank 7.
     0400             (campaign_maps.asm):00003         MAP_CACHE equ $0400
     0D20             (campaign_maps.asm):00004         MAP_LIST equ $0d20
     0D22             (campaign_maps.asm):00005         MAP_BITS_END equ $0d22
     0D24             (campaign_maps.asm):00006         MAP_CODE equ $0d24
     0D26             (campaign_maps.asm):00007         MAP_BITS_PTR equ $0d26
     0D28             (campaign_maps.asm):00008         MAP_SEG equ $0d28
     0D29             (campaign_maps.asm):00009         MAP_BAND equ $0d29
     0D2A             (campaign_maps.asm):00010         MAP_BITS equ $0d2a
     0D2B             (campaign_maps.asm):00011         MAP_GROUP equ $0d2b
     0D2C             (campaign_maps.asm):00012         MAP_MIRROR equ $0d2c
     0D2D             (campaign_maps.asm):00013         MAP_ROWS equ $0d2d
     0D2E             (campaign_maps.asm):00014         MAP_COLS equ $0d2e
     0D30             (campaign_maps.asm):00015         MAP_BAND_DEST equ $0d30
     0D32             (campaign_maps.asm):00016         MAP_GLOBAL equ $0d32
     0D33             (campaign_maps.asm):00017         MAP_CACHED equ $0d33
     0D34             (campaign_maps.asm):00018         MAP_STAGE equ $0d34
     0D35             (campaign_maps.asm):00019         MAP_PIXEL equ $0d35
     575B             (campaign_maps.asm):00020         MAP_DELTA equ campaign_blob-$99cd
43A5                  (campaign_maps.asm):00021         campaign_map_load
43A5 86FF             (campaign_maps.asm):00022                 lda #255
43A7 B70D33           (campaign_maps.asm):00023                 sta MAP_CACHED
43AA B70D34           (campaign_maps.asm):00024                 sta MAP_STAGE
43AD 39               (campaign_maps.asm):00025                 rts
                      (campaign_maps.asm):00026         ; D = world raster line, X = pointer to the requested 32-tile row.
43AE                  (campaign_maps.asm):00027         campaign_map_row
43AE 3466             (campaign_maps.asm):00028                 pshs d,y,u
43B0 F70D35           (campaign_maps.asm):00029                 stb MAP_PIXEL
43B3 44               (campaign_maps.asm):00030                 lsra
43B4 56               (campaign_maps.asm):00031                 rorb
